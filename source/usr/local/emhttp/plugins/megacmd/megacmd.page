              <option value="<?= htmlspecialchars($s['id']) ?>"><?= htmlspecialchars($s['local']) ?> &rarr; <?= htmlspecialchars($s['remote']) ?></option>
            <? endforeach; ?>
          </select>
        </div>
        <button type="submit" class="megacmd-stack-btn">Self-heal this sync</button>
      </form>
    <? endif; ?>
  <? endif; ?>
